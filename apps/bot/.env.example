# Discord Bot Token
TOKEN=your_discord_bot_token

# Discord Application Client ID
CLIENT_ID=your_discord_application_id

# Bot Owner Discord ID
OWNER_ID=your_discord_user_id

# Top.gg webhook signing secret (optional, for vote rewards)
# Use the v1 secret from Top.gg dashboard (starts with whs_).
# Must match apps/web/.env.local because the public webhook is verified there.
TOPGG_WEBHOOK_SECRET=whs_your_topgg_webhook_secret

# Legacy fallback only. Prefer TOPGG_WEBHOOK_SECRET for new deploys.
# TOPGG_TOKEN=whs_your_topgg_webhook_secret

# Public webhook URL to configure on Top.gg:
# https://pomofocus.online/topgg/webhook
#
# IMPORTANT: The same TOPGG_WEBHOOK_SECRET (whs_... secret) must also be set in
# apps/web/.env.local - signature verification runs there before the
# vote is forwarded to the bot on localhost:5000.
# VOTE_WEBHOOK_PORT=5000

# Top.gg API token (optional, for automatic server count posting)
TOPGG_API_TOKEN=your_topgg_api_token

# Premium Role System — Users with this role in this server get premium features
PREMIUM_GUILD_ID=your_support_server_id
PREMIUM_ROLE_ID=your_premium_role_id

# Support-server channels (optional)
LOG_CHANNEL_ID=your_log_channel_id
GUILD_LOG_CHANNEL_ID=channel_for_server_join_leave_logs
OWNER_LOG_CHANNEL_ID=channel_for_owner_alerts
FEEDBACK_CHANNEL_ID=channel_for_/feedback_suggestions
BUG_REPORT_CHANNEL_ID=channel_for_/feedback_bug_reports

# Role granted by a supporter/membership integration (optional)
# PREMIUM_MEMBERSHIP_ROLE_ID=your_membership_role_id

# SQLite database location (defaults to apps/bot/data/pomodoro.db)
# POMODORO_DB_PATH=/path/to/PomoDepo/apps/bot/data/pomodoro.db

# Support server invite used on bot buttons (defaults to the official Pomo server)
# SUPPORT_SERVER_URL=https://discord.gg/your-invite
# Link shown on premium upsells (defaults to https://boosty.to/pomobot)
# POMO_DONATION_URL=https://boosty.to/pomobot

# Streak protection after bot downtime (optional, hours)
# POMO_STREAK_DOWNTIME_GRACE_HOURS=
# POMO_STREAK_GRACE_WINDOW_HOURS=

# Boosty automatic Pro verification (optional)
# Run `node scripts/boostyLogin.js` once and paste the "auth" value from boosty.to
# Local Storage; it creates apps/bot/data/boosty_tokens.json (refreshed automatically).
BOOSTY_POLLER_ENABLED=false
BOOSTY_BLOG_NAME=pomobot
# BOOSTY_POLL_INTERVAL_MS=600000
# BOOSTY_PAID_PRICE_THRESHOLD=1

# Route Discord traffic through a proxy if the host blocks the gateway (optional)
# HTTPS_PROXY=http://host:port

# Custom Progress Bar Emojis (optional)
# Upload emojis to Discord Developer Portal, get their IDs,
# and set them here as: <:emoji_name:1234567890>
# Falls back to ▰/▱ unicode chars if not set
# EMOJI_BAR_START_FULL=<:bar_start_full:ID>
# EMOJI_BAR_START_EMPTY=<:bar_start_empty:ID>
# EMOJI_BAR_MID_FULL=<:bar_mid_full:ID>
# EMOJI_BAR_MID_EMPTY=<:bar_mid_empty:ID>
# EMOJI_BAR_END_FULL=<:bar_end_full:ID>
# EMOJI_BAR_END_EMPTY=<:bar_end_empty:ID>
