# Production site URL
NEXTAUTH_URL=https://pomofocus.online
NEXT_PUBLIC_SITE_URL=https://pomofocus.online

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_secret

# Discord OAuth application credentials
# Discord Developer Portal -> OAuth2 -> General
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_application_client_id

# Optional, improves dashboard/user display lookups and is REQUIRED for the
# server settings page (lists/validates guild channels).
# This is the Discord bot token. Keep it server-side only.
DISCORD_BOT_TOKEN=your_discord_bot_token
# Legacy alias, only read if DISCORD_BOT_TOKEN is empty.
# DISCORD_TOKEN=

# HMAC secret for Discord Activity / desktop sync tokens and Socket.io room
# tokens. Generate with: openssl rand -base64 32
# If unset, NEXTAUTH_SECRET (then DISCORD_CLIENT_SECRET) is used with a warning.
# Changing it invalidates already-issued activity/desktop tokens (6h lifetime).
ACTIVITY_TOKEN_SECRET=replace_with_random_secret

# Shared SQLite database path on VDS (the bot's DB; must already exist).
# Default when unset: ../bot/data/pomodoro.db relative to apps/web.
POMODORO_DB_PATH=/path/to/PomoDepo/apps/bot/data/pomodoro.db

# Optional Postgres (Pomo 2.0: web rooms, goals, notes, subjects, enriched todos).
# When unset those pages show a "not available" notice; everything backed by
# the SQLite DB keeps working.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/pomo

# Top.gg vote webhook secret.
# Must be the same whs_... value as PomoBot/.env.
# (TOPGG_TOKEN is read as a legacy fallback.)
TOPGG_WEBHOOK_SECRET=whs_your_topgg_webhook_secret

# Internal URL used by the website to forward verified Top.gg votes to the bot.
# Default in code is already this value, but keeping it explicit helps on VDS.
VOTE_PROCESS_INTERNAL_URL=http://127.0.0.1:5000/topgg/process

# Public links
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=/downloads/Pomo-Focus-Setup.exe
NEXT_PUBLIC_MICROSOFT_STORE_URL=https://apps.microsoft.com/detail/9PDMHQ05QR55

# Pomo Pro (Paddle).
# Webhook: Paddle → Developer tools → Notifications → New destination
#   URL https://pomofocus.online/api/billing/paddle
#   events: subscription.created, subscription.updated, subscription.canceled,
#   subscription.paused, subscription.resumed, subscription.past_due,
#   subscription.activated, adjustment.created, adjustment.updated
PADDLE_WEBHOOK_SECRET=
# sandbox or production (same value as PADDLE_ENV in apps/bot/.env)
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Developer tools → Authentication → Client-side tokens (test_... or live_...)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price ids (pri_...) of the monthly and yearly Pomo Pro prices
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
# In sandbox, only these Discord ids see the checkout (comma-separated)
PADDLE_TEST_DISCORD_IDS=

# Set to 1 to accept Discord Activity client diagnostics at /api/activity/debug
# in production (always on in development). Leave unset normally.
# ACTIVITY_DEBUG_ENABLED=

# Optional custom emoji overrides for progress bars (defaults are built in).
# EMOJI_BAR_START_FULL=
# EMOJI_BAR_START_EMPTY=
# EMOJI_BAR_MID_FULL=
# EMOJI_BAR_MID_EMPTY=
# EMOJI_BAR_END_FULL=
# EMOJI_BAR_END_EMPTY=

# Optional: HTTP port for `node server.js` (default 3000) and a fixed build id.
# PORT=3000
# NEXT_DEPLOYMENT_ID=
